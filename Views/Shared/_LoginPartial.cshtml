@using Microsoft.AspNetCore.Identity
@using NewVoyager.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<head>
    <link rel="stylesheet" type="text/css" href="~/css/style.css">
</head>

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a id="manage" class="loginBts" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">Hello @UserManager.GetUserName(User) </a>
    </li>
    <li class="nav-item">
        <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button class="loginBts" id="logout" type="submit" class="loginBts">Logout</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="loginBts"  id="register" asp-area="Identity" asp-page="/Account/Register">Register</a>
    </li>
    <li class="nav-item">
        <a class="loginBts" style="text-align: center;" id="login" asp-area="Identity" asp-page="/Account/Login">Login</a>
    </li>
}
</ul>
