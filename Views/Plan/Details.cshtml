@model NewVoyager.Models.Plans
@using Microsoft.AspNetCore.Identity
@using NewVoyager.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Details";
}

<link rel="stylesheet" type="text/css" href="~/css/site.css">
<link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />

<div class="planovi">
    <div class="planName">
        <p>@Html.DisplayFor(model => model.PlanName)</p>
                <form asp-action="AddCollaborator">
            <input type="hidden" name="planId" value="@Model.PlanID" />
            <div class="form-group">
                <label asp-for="Collaborators" class="control-label">Add a Collaborator</label>
                <input asp-for="Collaborators" name="CollaboratorID" class="form-control" value="@ViewBag.CollaboratorID"/>
                <span asp-validation-for="Collaborators" class="text-danger" ></span>
            </div>
            <div class="form-group dugme col-6" style="text-align: right;">
                    <input type="submit" value="Add Collaborator" class="btn" />
                </div>
        </form>
    </div>
    <hr />
    <div class="btn-AddTrip-container">
        <p class="trips-header">Trips</p>
       <div  style="position: absolute; left: 1rem; ">
            <a asp-controller="Trip" asp-action="Create" asp-route-planId="@Model.PlanID"  class="btn">Add Trip</a>
        </div>
    </div>
    <div class="devider">
        <div class="chatbox-left">
            <div class="chatbox-container">
                <h2 style="margin: bottom 0.5rem;">Chatbox</h2>
                <div id="chatbox">
                    @if (Model.ChatMessages == null || !Model.ChatMessages.Any())
                    {
                        <p>No messages yet.</p>
                    }
                    else
                    {
                        @foreach (var message in Model.ChatMessages)
                        {
                            <div>
                                <span>@(await UserManager.FindByIdAsync(message.SenderId)): </span><br>
                                <span>@message.Content</span>
                            </div>
                        }
                    }
                </div>
                <form id="chatForm" asp-controller="Plan" asp-action="SendMessage" method="post">
                    <input type="hidden" name="planId" value="@Model.PlanID" />
                    <input type="text" id="messageInput" name="messageContent" placeholder="Type your message here..." />
                    <button type="submit" class="btn">Send</button>
                </form>
            </div>
        </div>
        <div class="trips-right">
            <div class="container-fluid kartice-container">
                <div class="row">
                    @if (Model.Trips != null && Model.Trips.Any())
                    {
                        @foreach (var trip in Model.Trips)
                        {
                            decimal totalTripPrice = 0;
                            string newName = trip.TripName;
                            <div class="card col-3 mb-3" style="margin: auto">
                                <div class="card-header" style="background-color:#34495e; color:white">
                                    @if (trip.Events != null && trip.Events.Any())
                                    {
                                        foreach (var dogadjaj in trip.Events)
                                        {
                                            totalTripPrice += dogadjaj.Price ?? 0;
                                        }
                                        newName = trip.TripName + " - " + " " + totalTripPrice + "€";
                                    }
                                    @Html.DisplayFor(modelItem => newName)
                                    <br />
                                    @trip.DateFrom?.ToString("d") - @trip.DateTo?.ToString("d")
                                </div>
                                <div class="card-body">
                                    @if (trip.Events != null && trip.Events.Any())
                                    {
                                        foreach (var dogadjaj in trip.Events)
                                        {
                                            <div class="event-container form-check">
                                                <input class="form-check-input" type="checkbox" value="@dogadjaj.EventID" id="event_@dogadjaj.EventID">
                                                <label class="form-check-label" style="color: black;" for="event_@dogadjaj.EventID"> @dogadjaj.Opis @(dogadjaj.Price != null ? "- " + dogadjaj.Price + "€" : "") </label>
                                                <div class="event-actions">
                                                    <a asp-controller="Event" asp-action="Edit" asp-route-id="@dogadjaj.EventID">
                                                        <img class="event-icons" src="~/images/edit_icon.svg" alt="Edit">
                                                    </a> |
                                                    <a asp-controller="Event" asp-action="Details" asp-route-id="@dogadjaj.EventID">
                                                        <img class="event-icons" src="~/images/details_icon1.svg" alt="Details">
                                                    </a> |
                                                    <a asp-controller="Event" asp-action="Delete" asp-route-id="@dogadjaj.EventID">
                                                        <img class="event-icons" src="~/images/delete_icon.svg" alt="Delete">
                                                    </a>
                                                </div>
                                            </div>
                                        }
                                    }
                                    <a asp-controller="Event" asp-action="Create" asp-route-tripId="@trip.TripID" class="">
                                        <img class="icons" src="~/images/plus_icon.svg" alt="Add Event">
                                    </a>
                                </div>
                                <div class="card-footer" style="background-color:#34495e; color:#F9EBDE;">
                                    <a asp-controller="Trip" style="background-color:#F9EBDE; color:#34495e" asp-action="Edit" asp-route-id="@trip.TripID" class="btn ">
                                        <img class="icons" src="~/images/edit_icon.svg" alt="Edit">
                                    </a> |
                                    <a asp-controller="Trip" style="background-color:#F9EBDE; color:#34495e;" asp-action="Delete" asp-route-id="@trip.TripID" class="btn ">
                                        <img class="icons" src="~/images/delete_icon.svg" alt="Delete">
                                    </a>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div style="text-align: center;">
                            <p style="font-size: 1.5rem;">There are no trips for this plan yet!</p>
                        </div>
                    }
                    </div>
                </div>
            </div>
        </div>
    </div>
 </div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script>
        $(document).ready(function() {
            var tripCreationSuccessMessage = '@TempData["TripCreationSuccess"]';
            var tripCreationErrorMessage = '@TempData["TripCreationError"]';
            var tripEditSuccessMessage = '@TempData["TripEditSuccess"]';
            var tripEditErrorMessage = '@TempData["TripEditError"]';
            var tripDeletionSuccessMessage = '@TempData["TripDeletionSuccess"]';
            var tripDeletionErrorMessage = '@TempData["TripDeletionError"]';

            var eventCreationSuccessMessage = '@TempData["EventCreationSuccess"]';
            var eventCreationErrorMessage = '@TempData["EventCreationError"]';
            var eventEditSuccessMessage = '@TempData["EventEditSuccess"]';
            var eventEditErrorMessage = '@TempData["EventEditError"]';
            var eventDeletionSuccessMessage = '@TempData["EventDeletionSuccess"]';
            var eventDeletionErrorMessage = '@TempData["EventDeletionError"]';
            
            if (tripCreationSuccessMessage) {
                toastr.success(tripCreationSuccessMessage);
            }
            if (tripCreationErrorMessage) {
                toastr.error(tripCreationErrorMessage);
            }
            if (tripEditSuccessMessage) {
                toastr.success(tripEditSuccessMessage);
            }
            if (tripEditErrorMessage) {
                toastr.error(tripEditErrorMessage);
            }
            if (tripDeletionSuccessMessage) {
                toastr.success(tripDeletionSuccessMessage);
            }
            if (tripDeletionErrorMessage) {
                toastr.error(tripDeletionErrorMessage);
            }
            if (eventCreationSuccessMessage) {
                toastr.success(eventCreationSuccessMessage);
            }
            if (eventCreationErrorMessage) {
                toastr.error(eventCreationErrorMessage);
            }
             if (eventEditSuccessMessage) {
                toastr.success(eventEditSuccessMessage);
            }
            if (eventEditErrorMessage) {
                toastr.error(eventEditErrorMessage);
            }
            if (eventDeletionSuccessMessage) {
                toastr.success(eventDeletionSuccessMessage);
            }
            if (eventDeletionErrorMessage) {
                toastr.error(eventDeletionErrorMessage);
            }
        });
    </script>
}