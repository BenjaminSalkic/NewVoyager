@using Microsoft.AspNetCore.Identity
@model IEnumerable<NewVoyager.Models.Plans>
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Index";
}

<head>
    <link rel="stylesheet" type="text/css" href="~/css/site.css" />
    <link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
</head>
<div class="btn-AddPlan-container" style="margin-top: 15px;">
    <!-- Display the username instead of the user ID -->
    <p class="IdBtn" onclick="copyUserId()" >Your ID</p>
    <p class="plan-header">Your plans:</p>
    <div class="btn-AddPlan">
        <a asp-action="Create" class="btn">Create new plan</a>
    </div>
</div>
<hr />
<div class="container-fluid">
@if(Model.Any())
{    
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-3" style="margin: auto;"> <!-- Adjust the column size as needed -->
                <div class="card mb-4">
                    <div class="card-body" style="padding: 0px; margin-top:0px;">
                        <h5 class="card-title">@Html.DisplayFor(modelItem => item.PlanName)</h5>
                        <div class="card-actions row" style="padding: 10px;">
                            <div class="col-3 action">
                                <a asp-action="Edit" asp-route-id="@item.PlanID" class="event-btn">
                                    <img class="event-icons" src="~/images/edit_icon.svg" alt="Edit">
                                </a>
                            </div>
                            <div class="col-3 action">
                                <a asp-action="Details" asp-route-id="@item.PlanID" class="event-btn">
                                    <img class="event-icons" src="~/images/details_icon1.svg" alt="Details">
                                </a>
                            </div>
                            <div class="col-3 action">
                                <a asp-action="Delete" asp-route-id="@item.PlanID" class="event-btn">
                                    <img class="event-icons" src="~/images/delete_icon.svg" alt="Delete">
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else{
    <div style="text-align:center; margin-top:20px;">
        <p style="font-size: 1.5rem;">You currently have no plans!</p>
    </div>
}
</div>

@section Scripts {
    
<script>
    // Function to copy user ID to clipboard
    function copyUserId() {
        // Get the user ID from the server-side Razor code
        var userId = '@UserManager.GetUserId(User)';
        
        // Create a temporary input element to copy the user ID to the clipboard
        var tempInput = document.createElement("input");
        tempInput.value = userId;
        document.body.appendChild(tempInput);
        tempInput.select();
        document.execCommand("copy");
        document.body.removeChild(tempInput);

        // Display a message or perform any other actions after copying the user ID
        toastr.success('User ID copied to clipboard');
    }

    // Add click event listener to the user ID element
    document.querySelector('.user-Id').addEventListener('click', copyUserId);
    </script>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script>
         $(document).ready(function() {
            var creationSuccessMessage = '@TempData["PlanCreationSuccess"]';
            var creationErrorMessage = '@TempData["PlanCreationError"]';
            var deletionSuccessMessage = '@TempData["PlanDeletionSuccess"]';
            var deletionErrorMessage = '@TempData["PlanDeletionError"]';
            var editSuccessMessage = '@TempData["PlanEditSuccess"]';
            var editErrorMessage = '@TempData["PlanEditError"]';
            if (creationSuccessMessage) {
                toastr.success(creationSuccessMessage);
            }
            if (creationErrorMessage) {
                toastr.error(creationErrorMessage);
            }
            if (deletionSuccessMessage) {
                toastr.success(deletionSuccessMessage);
            }
            if (deletionErrorMessage) {
                toastr.error(deletionErrorMessage);
            }
            if (editSuccessMessage) {
                toastr.success(editSuccessMessage);
            }
            if (editErrorMessage) {
                toastr.error(editErrorMessage);
            }
        });
    </script>
}
